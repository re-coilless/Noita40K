<Entity name="warpfire" >
	<Base file="mods/n40k/files/based/status_effect.xml" >
		<GameEffectComponent custom_effect_id="WARPFIRE" />
	</Base>
	
	<ParticleEmitterComponent
		emitted_material_name="warpflame"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="2"
		y_pos_offset_max="-2"
		x_vel_min="-2"
		x_vel_max="2"
		y_vel_min="-50"
		y_vel_max="-30"
		count_min="10"
		count_max="15"
		lifetime_min="40"
		lifetime_max="50"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="5"
		emitter_lifetime_frames="-1"
		is_emitting="1"
	></ParticleEmitterComponent>
	
	<SpriteComponent 
		alpha="0.6"
		image_file="data/particles/fog_of_war_hole.xml"
		smooth_filtering="1"
		fog_of_war_hole="1"
	></SpriteComponent>
	
	<LightComponent
		radius="128"
		fade_out_time="2"
		r="255" g="0" b="166"
	></LightComponent>
	<LightComponent
		radius="64"
		r="255" g="0" b="166"
	></LightComponent>
	<LightComponent
		radius="64"
		r="255" g="0" b="166"
	></LightComponent>
	
	<AudioComponent
		file="data/audio/Desktop/misc.bank"
		event_root="game_effect/on_fire"
		set_latest_event_position="1"
	></AudioComponent>
	<AudioLoopComponent
		file="data/audio/Desktop/misc.bank"
		event_name="game_effect/on_fire/burning" 
		auto_play="1"
	></AudioLoopComponent>

	<UIIconComponent
		name="$n40k_EFFECT_warpfire" description="$n40k_EFFECT_warpfire_"
		icon_sprite_file="mods/n40k/files/effects/status/warpfire.png"
		display_above_head="1" display_in_hud="1" is_perk="0"
	></UIIconComponent>
	
	<VariableStorageComponent name="got_scaled" value_bool="0" />
	<VariableStorageComponent name="is_hollowed" value_bool="0" />
	<VariableStorageComponent name="vector_effect" value_string="mods/n40k/files/effects/status/warpfire.lua" />
</Entity>